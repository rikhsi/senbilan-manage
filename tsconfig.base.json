{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": false,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2023", "dom", "dom.iterable"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "paths": {
      "@senbilan/core/domain": ["./libs/core/domain/src/index.ts"],
      "@senbilan/design-system/ui": ["./libs/design-system/ui/src/index.ts"],
      "@senbilan/core/application": ["./libs/core/application/src/index.ts"],
      "@senbilan/shared/util": ["./libs/shared/util/src/index.ts"],
      "@senbilan/shared/ng": ["./libs/shared/ng/src/index.ts"],
      "@senbilan/shared/config": ["./libs/shared/config/src/index.ts"],
      "@senbilan/shared/i18n": ["./libs/shared/i18n/src/index.ts"],
      "@senbilan/shared/query": ["./libs/shared/query/src/index.ts"],
      "@senbilan/shared/auth": ["./libs/shared/auth/src/index.ts"],
      "@senbilan/shared/theme": ["./libs/shared/theme/src/index.ts"],
      "@senbilan/shared/command": ["./libs/shared/command/src/index.ts"],
      "@senbilan/shared/testing": ["./libs/shared/testing/src/index.ts"],
      "@senbilan/design-system/tokens": ["./libs/design-system/tokens/src/index.ts"],
      "@senbilan/design-system/icons": ["./libs/design-system/icons/src/index.ts"],
      "@senbilan/design-system/layout": ["./libs/design-system/layout/src/index.ts"],
      "@senbilan/platform/core": ["./libs/platform/core/src/index.ts"],
      "@senbilan/platform/mobile": ["./libs/platform/mobile/src/index.ts"],
      "@senbilan/infra/api": ["./libs/infra/api/src/index.ts"],
      "@senbilan/infra/storage": ["./libs/infra/storage/src/index.ts"],
      "@senbilan/infra/mock": ["./libs/infra/mock/src/index.ts"],
      "@senbilan/infra/observability": ["./libs/infra/observability/src/index.ts"],
      "@senbilan/entities/user": ["./libs/entities/user/src/index.ts"],
      "@senbilan/entities/role": ["./libs/entities/role/src/index.ts"],
      "@senbilan/entities/permission": ["./libs/entities/permission/src/index.ts"],
      "@senbilan/entities/notification": ["./libs/entities/notification/src/index.ts"],
      "@senbilan/features/auth": ["./libs/features/auth/src/index.ts"],
      "@senbilan/features/dashboard": ["./libs/features/dashboard/src/index.ts"],
      "@senbilan/features/users": ["./libs/features/users/src/index.ts"],
      "@senbilan/features/roles": ["./libs/features/roles/src/index.ts"],
      "@senbilan/features/permissions": ["./libs/features/permissions/src/index.ts"],
      "@senbilan/features/settings": ["./libs/features/settings/src/index.ts"],
      "@senbilan/features/notifications": ["./libs/features/notifications/src/index.ts"],
      "@senbilan/features/profile": ["./libs/features/profile/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp", "dist"]
}
