# Shared defaults (committed). Copy to .env.local for machine-specific overrides.
# Angular apps use apps/*/src/environments/*.ts via fileReplacements — these root
# .env* files are for tooling, scripts, and future CI inject steps.

APP_NAME=Senbilan Manage
DEFAULT_LOCALE=ru
API_BASE_URL=https://api.senbilan.uz
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
FEATURE_MOCK_API=false
FEATURE_PWA=false

# Admin OpenAPI sync (`npm run openapi:sync`) — put real values in `.env.local` only
OPENAPI_ADMIN_URL=https://api.senbilan.uz/docs/admin/openapi.json
OPENAPI_ADMIN_USER=
OPENAPI_ADMIN_PASSWORD=
