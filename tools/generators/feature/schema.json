{
  "$schema": "https://json-schema.org/schema",
  "$id": "SenbilanFeature",
  "title": "Feature library",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Feature name (kebab-case)",
      "$default": { "$source": "argv", "index": 0 },
      "x-prompt": "Feature name"
    },
    "directory": {
      "type": "string",
      "description": "Parent directory under libs/features",
      "default": ""
    }
  },
  "required": ["name"]
}
