{
  "$schema": "https://json-schema.org/schema",
  "$id": "SenbilanUiComponent",
  "title": "UI component",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Component name without app- prefix (kebab-case)",
      "$default": { "$source": "argv", "index": 0 },
      "x-prompt": "Component name (e.g. chip)"
    }
  },
  "required": ["name"]
}
